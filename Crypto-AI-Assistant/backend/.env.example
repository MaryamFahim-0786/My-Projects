LLM_PROVIDER=gemini
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Valid current model names: gemini-3.5-flash (recommended), gemini-2.5-flash,
# gemini-3-flash-preview. "gemini-3.6-flash" does NOT exist — using it will
# cause errors even with a valid key.
GEMINI_MODEL=gemini-3.5-flash

COINGECKO_API_KEY=
# Optional — only used if you have one. Without it, news comes free from
# public RSS feeds (CoinDesk + Cointelegraph), no signup needed.
CRYPTOCOMPARE_API_KEY=
PORT=5000
FLASK_DEBUG=0
